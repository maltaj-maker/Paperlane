# ---------------------------------------------------------------------------
# Paperlane Books — environment template
# Copy to `.env` (dev) or `.env.production` and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Paperlane Books"

# --- Database ---
# Dev default is SQLite (zero setup). For production switch prisma/schema.prisma
# `provider` to "postgresql" and use a pooled connection string.
DATABASE_URL="file:./dev.db"

# --- Auth / crypto ---
# REQUIRED. 32+ random bytes. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in days
SESSION_TTL_DAYS=30

# --- Logging ---
LOG_LEVEL=info
# JSON logs are ideal for production log shipping
LOG_FORMAT=pretty

# --- Feature flags (DB FeatureFlag rows override these at runtime) ---
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_NEWSLETTER=true
FEATURE_SUPPORT_TICKETS=true
FEATURE_BLOG=true
FEATURE_LOYALTY=false
FEATURE_REFERRALS=false
FEATURE_CHATBOT=false
FEATURE_GIFT_CARDS=false

# --- Payments ---
# mock | stripe | phonepe   (mock is ONLY for local dev/test)
PAYMENTS_PROVIDER=mock
PAYMENT_CURRENCY=INR
# Optional presentment rates (major currency units per ₹1). Refresh from your FX source.
# Example: CURRENCY_RATES_JSON={"USD":0.0119,"EUR":0.0101,"GBP":0.0088}
# Rates must be refreshed by your chosen FX provider before expiry; never hard-code stale production rates.
CURRENCY_RATES_JSON=
# Block real charges outside production even if keys are present
PAYMENT_ALLOW_LIVE=false

# Stripe Checkout (recommended global provider)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PhonePe PG (v2). Get these from the PhonePe merchant dashboard.
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Public URL PhonePe will POST webhooks to, e.g. https://shop.example.com/api/v1/webhooks/phonepe
PHONEPE_WEBHOOK_URL=

# --- Email / SMS / WhatsApp (all optional; falls back to console transport) ---
EMAIL_PROVIDER=console
EMAIL_FROM="Paperlane Books <hello@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=console
SMS_SENDER_ID=
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# --- Analytics (privacy-conscious: disabled unless explicitly enabled) ---
ANALYTICS_PROVIDER=none
ANALYTICS_REQUIRE_CONSENT=true
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Instagram / social (used for deep links + social proof) ---
SOCIAL_INSTAGRAM_URL=https://instagram.com/
SOCIAL_INSTAGRAM_HANDLE=paperlane.books
SOCIAL_X_URL=
SOCIAL_FACEBOOK_URL=

# --- Support / ops ---
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
ERROR_MONITORING_DSN=
SENTRY_ENABLED=false

# --- Store policy knobs (also editable at runtime via admin Settings) ---
STORE_SUPPORT_COD=true
STORE_FREE_SHIPPING_THRESHOLD_PAISE=79900
STORE_DEFAULT_TAX_CODE=books_print
